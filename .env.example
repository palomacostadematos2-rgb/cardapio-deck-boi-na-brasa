# Exemplo de variáveis de ambiente. O projeto já vem com um arquivo
# .env versionado com valores padrão de desenvolvimento — use este
# arquivo como referência ou para criar um .env.local (não versionado)
# com valores específicos da sua máquina/publicação.

# URL pública onde o cardápio está publicado, sem barra no final.
# Usada para: gerar o QR Code (npm run qrcode) e as tags de SEO/Open
# Graph/Twitter Card.
VITE_APP_URL=https://seudominio.com.br

# Nome do restaurante, usado em toda a interface e nos metadados.
VITE_RESTAURANT_NAME=Deck Boi na Brasa Grill

# Descrição curta usada na Home e como meta description padrão.
VITE_RESTAURANT_DESCRIPTION=Churrasco no ponto, ambiente descontraído e muito sabor na brasa.
