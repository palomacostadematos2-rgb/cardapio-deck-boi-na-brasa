# Configuração pública de build (sem segredos — estas variáveis são
# incluídas no bundle do cliente). Ajuste antes de publicar em produção
# e execute "npm run qrcode" novamente após alterar VITE_APP_URL.

# URL pública onde o cardápio está publicado, sem barra no final.
# Usada para: gerar o QR Code e as tags de SEO/Open Graph/Twitter Card.
VITE_APP_URL=http://localhost:5173

# Nome do restaurante, usado em toda a interface e nos metadados.
VITE_RESTAURANT_NAME=Deck Boi na Brasa Grill

# Descrição curta usada na Home e como meta description padrão.
VITE_RESTAURANT_DESCRIPTION=Churrasco no ponto, ambiente descontraído e muito sabor na brasa.
